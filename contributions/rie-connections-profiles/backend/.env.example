# Copy to backend/.env and adjust. Never commit the real .env file.

# Required for stable logins across restarts. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

DATABASE_URL=sqlite:///./trojanlink.db
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fictional demo accounts (local development only). The same password is used for
# every seeded demo user. Leave DEMO_USER_PASSWORD empty to skip seeding.
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=trojan-demo-2026

# Optional LLM (Anthropic Messages API). Leave empty to use the deterministic fallback.
# The LLM is only called when the user explicitly opts in on each request.
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Resume uploads (local disk). Defaults: backend/uploads, 5 MB.
# UPLOAD_DIR=./uploads
# MAX_RESUME_MB=5
