# Copy to .env and edit (never commit .env)

# Unset = local SQLite file referral_board.db (recommended for the hackathon)
# DATABASE_URL=sqlite:///./referral_board.db

SECRET_KEY=change-me-to-a-long-random-string

# console = print code to terminal + return dev_code from /auth/register (dev/demo)
# smtp    = actually send email
EMAIL_BACKEND=console
# Gmail example: enable 2-Step Verification, then create a 16-char password under Google Account -> App passwords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourteam.referralboard@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_FROM=yourteam.referralboard@gmail.com
